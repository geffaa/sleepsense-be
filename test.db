-- Create custom types
CREATE TYPE user_role AS ENUM ('patient', 'doctor');
CREATE TYPE analysis_status AS ENUM ('pending', 'approved', 'rejected');
CREATE TYPE severity_level AS ENUM ('mild', 'moderate', 'severe');
CREATE TYPE event_type AS ENUM ('apnea', 'hypopnea', 'normal');

-- Create tables with consolidated structure
CREATE TABLE users (
  id SERIAL PRIMARY KEY,
  email VARCHAR(255) UNIQUE NOT NULL,
  password VARCHAR(255) NOT NULL,
  full_name VARCHAR(255) NOT NULL,
  role user_role NOT NULL,
  
  -- Account security fields
  login_attempts INTEGER DEFAULT 0,
  locked_until TIMESTAMP,
  last_login TIMESTAMP,
  
  -- Password reset fields
  reset_token VARCHAR(255),
  reset_token_expires TIMESTAMP,
  
  -- Session management fields
  refresh_token VARCHAR(255),
  refresh_token_expires TIMESTAMP,
  
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE patients (
  id SERIAL PRIMARY KEY,
  user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
  gender VARCHAR(50),
  age INTEGER,
  height DECIMAL,
  weight DECIMAL,
  medical_conditions TEXT[],
  medications TEXT[],
  doctor_id INTEGER REFERENCES users(id) ON DELETE SET NULL,
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE doctors (
  id SERIAL PRIMARY KEY,
  user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
  specialty VARCHAR(255),
  license_number VARCHAR(255),
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE devices (
  id SERIAL PRIMARY KEY,
  serial_number VARCHAR(255) UNIQUE NOT NULL,
  patient_id INTEGER REFERENCES patients(id) ON DELETE SET NULL,
  firmware_version VARCHAR(50),
  last_sync TIMESTAMP,
  battery_level INTEGER,
  status VARCHAR(50),
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE sleep_data (
  id SERIAL PRIMARY KEY,
  patient_id INTEGER REFERENCES patients(id) ON DELETE CASCADE,
  device_id INTEGER REFERENCES devices(id) ON DELETE SET NULL,
  date DATE NOT NULL,
  start_time TIMESTAMP NOT NULL,
  end_time TIMESTAMP,
  sleep_duration DECIMAL,
  sleep_quality INTEGER,
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE sleep_analysis (
  id SERIAL PRIMARY KEY,
  sleep_data_id INTEGER REFERENCES sleep_data(id) ON DELETE CASCADE,
  ahi DECIMAL NOT NULL,
  apnea_events INTEGER NOT NULL,
  hypopnea_events INTEGER NOT NULL,
  lowest_oxygen DECIMAL,
  avg_oxygen DECIMAL,
  time_below90 INTEGER,
  severity severity_level,
  status analysis_status DEFAULT 'pending',
  doctor_id INTEGER REFERENCES users(id) ON DELETE SET NULL,
  doctor_notes TEXT,
  reviewed_at TIMESTAMP,
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE sleep_events (
  id SERIAL PRIMARY KEY,
  sleep_data_id INTEGER REFERENCES sleep_data(id) ON DELETE CASCADE,
  type event_type NOT NULL,
  start_time TIMESTAMP NOT NULL,
  duration INTEGER NOT NULL,
  oxygen_drop DECIMAL,
  severity severity_level,
  confidence DECIMAL,
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE sensor_data (
  id SERIAL PRIMARY KEY,
  sleep_data_id INTEGER REFERENCES sleep_data(id) ON DELETE CASCADE,
  timestamp TIMESTAMP NOT NULL,
  ecg DECIMAL,
  oxygen DECIMAL,
  thorax DECIMAL,
  breathing DECIMAL,
  heart_rate INTEGER,
  has_apnea_event BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

-- Add notifications table (more efficient as separate table for high-volume notifications)
CREATE TYPE notification_type AS ENUM ('system', 'analysis', 'appointment', 'device');

CREATE TABLE notifications (
  id SERIAL PRIMARY KEY,
  user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
  type notification_type NOT NULL,
  title VARCHAR(255) NOT NULL,
  message TEXT NOT NULL,
  is_read BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

-- Add audit_logs table (more efficient as separate table due to high volume)
CREATE TABLE audit_logs (
  id SERIAL PRIMARY KEY,
  user_id INTEGER REFERENCES users(id) ON DELETE SET NULL,
  action VARCHAR(255) NOT NULL,
  table_name VARCHAR(50) NOT NULL,
  record_id INTEGER NOT NULL,
  old_data JSONB,
  new_data JSONB,
  ip_address VARCHAR(50),
  user_agent TEXT,
  created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

-- Add indexes for better performance
CREATE INDEX idx_users_email ON users(email);
CREATE INDEX idx_users_role ON users(role);
CREATE INDEX idx_users_reset_token ON users(reset_token);

CREATE INDEX idx_patients_user_id ON patients(user_id);
CREATE INDEX idx_patients_doctor_id ON patients(doctor_id);

CREATE INDEX idx_doctors_user_id ON doctors(user_id);

CREATE INDEX idx_devices_patient_id ON devices(patient_id);
CREATE INDEX idx_devices_serial_number ON devices(serial_number);

CREATE INDEX idx_sleep_data_patient_id ON sleep_data(patient_id);
CREATE INDEX idx_sleep_data_date ON sleep_data(date);

CREATE INDEX idx_sleep_analysis_sleep_data_id ON sleep_analysis(sleep_data_id);
CREATE INDEX idx_sleep_analysis_status ON sleep_analysis(status);

CREATE INDEX idx_sleep_events_sleep_data_id ON sleep_events(sleep_data_id);
CREATE INDEX idx_sleep_events_type ON sleep_events(type);

CREATE INDEX idx_sensor_data_sleep_data_id ON sensor_data(sleep_data_id);
CREATE INDEX idx_sensor_data_timestamp ON sensor_data(timestamp);

CREATE INDEX idx_notifications_user_id ON notifications(user_id);
CREATE INDEX idx_notifications_is_read ON notifications(is_read);

CREATE INDEX idx_audit_logs_user_id ON audit_logs(user_id);
CREATE INDEX idx_audit_logs_table_name ON audit_logs(table_name);
CREATE INDEX idx_audit_logs_created_at ON audit_logs(created_at);

-- Create a function to clean up old sensor data
CREATE OR REPLACE FUNCTION cleanup_old_sensor_data() RETURNS TRIGGER AS $$
BEGIN
  -- Keep only the last 6 months of data
  DELETE FROM sensor_data WHERE created_at < NOW() - INTERVAL '6 months';
  RETURN NULL;
END;
$$ LANGUAGE plpgsql;

-- Trigger for periodic cleanup
CREATE TRIGGER cleanup_sensor_data_trigger
  AFTER INSERT ON sleep_data
  EXECUTE PROCEDURE cleanup_old_sensor_data();

-- Function to update the 'updated_at' timestamp
CREATE OR REPLACE FUNCTION update_modified_column() RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Add triggers to automatically update the 'updated_at' column
CREATE TRIGGER update_users_modtime BEFORE UPDATE ON users FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_patients_modtime BEFORE UPDATE ON patients FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_doctors_modtime BEFORE UPDATE ON doctors FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_devices_modtime BEFORE UPDATE ON devices FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_sleep_data_modtime BEFORE UPDATE ON sleep_data FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_sleep_analysis_modtime BEFORE UPDATE ON sleep_analysis FOR EACH ROW EXECUTE PROCEDURE update_modified_column();