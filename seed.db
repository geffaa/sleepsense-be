-- Seed data for SleepSense PostgreSQL Database
-- Run this script after creating the database schema

-- Clear existing data (optional - comment out if you want to keep existing data)
TRUNCATE users, patients, doctors, devices, sleep_data, sleep_analysis, sleep_events, sensor_data, notifications, audit_logs CASCADE;

