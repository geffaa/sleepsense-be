-- Function to get random float
CREATE OR REPLACE FUNCTION random_float(min_val FLOAT, max_val FLOAT) RETURNS FLOAT AS $$
BEGIN
  RETURN min_val + (max_val - min_val) * random();
END;
$$ LANGUAGE plpgsql;

